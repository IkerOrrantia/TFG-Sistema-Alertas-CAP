---
import '../styles/global.css';
import { ui } from '../i18n/ui.js';
import credenciales from '../../config.json';

// ==========================================
// IDIOMA DEL TÓTEM (Cambia a 'es', 'en', 'eu' o 'pt' según tu preferencia en el config.json)
const LANG = credenciales.LANGUAGE; 
// ==========================================

function t(key: string) {
    return (ui as any)[LANG][key] || key;
}
---

<!DOCTYPE html>
<html lang={LANG}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RETIME - Multi-Hazard Dashboard</title>
    
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/paho-mqtt/1.0.1/mqttws31.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Inter', sans-serif; }
        .pulse-red { animation: pulseRed 2s infinite; }
        @keyframes pulseRed { 
            0% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); } 
            70% { box-shadow: 0 0 0 20px rgba(220, 38, 38, 0); } 
            100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); } 
        }
        .slide-in { animation: slideIn 0.5s ease-out; }
        @keyframes slideIn { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
    </style>
</head>
<body class="bg-[#e9e9e9] text-slate-800 min-h-screen flex flex-col transition-colors duration-700" id="main-body">

    <header class="bg-white border-b-2 border-black/10 px-6 py-4 flex justify-between items-center shadow-sm z-20 sticky top-0">
        <div class="flex items-center gap-4">
            <div class="bg-slate-900 text-white font-black px-3 py-1 text-xl tracking-tighter rounded">RETIME</div>
            <div class="leading-tight border-l-2 border-gray-300 pl-4">
                <h1 class="text-xl font-bold text-slate-900 tracking-tight">{t('nav.title')}</h1>
                <p class="text-xs text-gray-500 font-semibold uppercase tracking-widest">{t('nav.subtitle')}</p>
            </div>
        </div>
        <div class="text-right">
            <div id="clock" class="text-2xl font-bold font-mono text-slate-700">--:--</div>
            <div class="flex items-center justify-end gap-2 text-xs font-bold text-gray-400 uppercase">
                <span id="conn-dot" class="w-2 h-2 rounded-full bg-red-500"></span>
                <span id="conn-text">Offline</span>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-7xl mx-auto w-full p-6 flex flex-col gap-6">

        <section id="alert-card" class="bg-white rounded-3xl border border-gray-200 shadow-xl overflow-hidden flex flex-col landscape:flex-row transition-all duration-500 transform">
            <div id="alert-side-color" class="w-full h-4 landscape:w-4 landscape:h-auto bg-gray-300 transition-colors duration-500"></div>
            
            <div class="p-8 flex-1 flex flex-col landscape:flex-row items-center gap-8">
                <div class="flex-shrink-0">
                    <div id="alert-icon-bg" class="w-28 h-28 rounded-full bg-gray-100 flex items-center justify-center shadow-inner transition-colors duration-500">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16 text-gray-400"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                    </div>
                </div>

                <div class="flex-1 text-center landscape:text-left">
                    <div class="flex items-center gap-3 mb-2 justify-center landscape:justify-start">
                        <span id="alert-badge" class="px-3 py-1 rounded-full bg-gray-200 text-gray-600 text-xs font-bold uppercase tracking-wider">{t('status.waiting')}</span>
                    </div>
                    <h2 id="headline" class="text-5xl font-black leading-none text-slate-900 mb-4 uppercase tracking-tight">{t('status.init')}</h2>
                </div>

                <div class="flex gap-4 w-full max-w-sm mt-2">
                    <!-- Sensor: Temperatura -->
                    <div class="bg-slate-50 border border-slate-200 rounded-xl flex-1 py-3 text-center shadow-sm">
                        <p class="text-[9px] text-gray-500 uppercase font-black tracking-widest mb-1">{t('sensor.temp')}</p>
                        <div class="flex items-baseline justify-center gap-1">
                            <p id="sensor-temp-val" class="text-4xl font-black text-slate-800 font-mono">--</p>
                            <p class="text-sm text-gray-400 font-bold">°C</p>
                        </div>
                    </div>
                    
                    <!-- Sensor: Calidad del Aire (AQI) -->
                    <div class="bg-slate-50 border border-slate-200 rounded-xl flex-1 py-3 px-2 text-center shadow-sm flex flex-col items-center justify-center">
                        <p class="text-[9px] text-gray-500 uppercase font-black tracking-widest mb-2">{t('sensor.aqi')}</p>
                        <div class="flex items-center justify-center gap-3">            
                            <div id="sensor-aqi-icono" class="text-slate-300 transition-colors duration-300">
                                <svg class="w-10 h-10 animate-pulse" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" opacity="0.2"/></svg>
                            </div>
                            <p id="sensor-aqi-texto" class="text-sm font-black uppercase tracking-wide text-gray-400 transition-colors duration-300">
                                Cargando...
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="grid grid-cols-1 landscape:grid-cols-3 gap-6 flex-1 min-h-0">
            
            <!-- TARJETA DEL VÍDEO (2 columnas en horizontal) -->
            <section class="landscape:col-span-2 bg-white rounded-2xl border border-gray-200 shadow-sm p-6 flex flex-col h-full">
                 <!-- TEXTO ARRIBA -->
                 <div class="mb-4">
                     <h3 class="text-lg font-bold text-slate-800 mb-2 flex items-center gap-2">
                         <span class="bg-blue-100 text-blue-600 p-1.5 rounded">
                             <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" /></svg>
                         </span> {t('details.title')}
                     </h3>
                     <p id="description" class="text-lg text-gray-600 leading-tight">{t('details.empty')}</p>
                 </div>
 
                 <!-- CONTENEDOR DEL VÍDEO (Limpio y sin bordes grises) -->
                 <div class="flex-1 w-full relative min-h-[220px]">
                     <!-- Al quitar bg-slate-50 y shadow-inner, el vídeo se funde con el fondo blanco -->
                     <video id="mascot-video" class="absolute inset-0 w-full h-full object-contain p-2" autoplay loop muted playsinline>
                         <source id="mascot-source" src="/mascota-idle.mp4" type="video/mp4" />
                         Tu navegador no soporta video HTML5.
                     </video>
                 </div>
             </section>
 
             <!-- COLUMNA DERECHA / INFERIOR (Historial + SOS separados) -->
             <div class="flex flex-col gap-6">
                 
                 <!-- TARJETA DEL HISTORIAL (Ocupará el espacio disponible) -->
                 <section class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 flex flex-col flex-1 min-h-[160px]">
                     <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                         <span class="bg-yellow-100 text-yellow-600 p-1.5 rounded">
                             <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                         </span> {t('history.title')}
                     </h3>
                     
                     <div id="history-container" class="space-y-3 overflow-y-hidden flex-1">
                         <div class="text-center text-gray-400 text-sm py-4 italic">{t('history.empty')}</div>
                     </div>
                 </section>
                 
                 <!-- BOTÓN SOS (Fijo al fondo) -->
                 <div class="bg-red-600 text-white rounded-2xl p-5 shadow-lg flex items-center justify-between flex-shrink-0">
                     <div class="text-left">
                         <p class="text-xs font-bold uppercase text-red-100 opacity-80">Emergency SOS</p>
                         <p class="text-3xl font-black">112</p>
                     </div>
                     <div class="text-white opacity-90">
                         <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.48-4.18-7.076-7.076l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
                     </div>
                 </div>
 
             </div>
         </div>
    </main>
    </main>

    <script is:inline define:vars={{ ui, LANG, credenciales }}>
        // 1. UTILIDADES, RELOJ E ICONOS
        const trans = (key) => ui[LANG][key] || key;

        setInterval(() => {
            const clock = document.getElementById('clock');
            if (clock) {
                clock.innerText = new Date().toLocaleTimeString('es-ES', {hour: '2-digit', minute: '2-digit'});
            }
        }, 1000);

        // Iconos en formato SVG para la interfaz
        const iconFire = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1A3.75 3.75 0 0012 18z" /></svg>`;
        const iconAlert = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`;
        const iconWarning = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`;
        const iconShield = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`;

        // Variables globales para guardar el clima y AQI y usarlos en los vídeos
        window.climaLocal = {
            llueve: false,
            aqi: 0
        };

        // 1.4 HELPER ACTUALIZADO (Con multi-idioma)
        function obtenerDatosAQI(valorAQI) {
            const svgBueno = `<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z"/></svg>`;
            const svgPrecaucion = `<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm-2 4h8v2H7v-2z"/></svg>`;
            const svgPeligro = `<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 3.5c-2.33 0-4.31 1.46-5.11 3.5h10.22c-.8-2.04-2.78-3.5-5.11-3.5z"/></svg>`;

            // Usamos tu función trans() para obtener los textos del diccionario
            if (valorAQI <= 50)  return { texto: trans('aqi.good') || "Buena", color: "text-green-500", icono: svgBueno };
            if (valorAQI <= 100) return { texto: trans('aqi.moderate') || "Moderada", color: "text-yellow-500", icono: svgPrecaucion };
            if (valorAQI <= 150) return { texto: trans('aqi.sensitive') || "Sensibles", color: "text-orange-500", icono: svgPrecaucion };
            if (valorAQI <= 200) return { texto: trans('aqi.bad') || "Mala", color: "text-red-500", icono: svgPeligro };
            if (valorAQI <= 300) return { texto: trans('aqi.very_bad') || "Muy Mala", color: "text-purple-600", icono: svgPeligro };
            return { texto: trans('aqi.hazardous') || "Peligrosa", color: "text-red-900", icono: svgPeligro };
        }

        // 1.5 API METEOROLÓGICA
        async function fetchLocalTelemetry() {
            try {
                const lat = credenciales.LAT || "38.7167";
                const lon = credenciales.LON || "-9.1333";
                
                // Petición de Temperatura (Corregida añadiendo weather_code)
                const tempResponse = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code`);
                const tempData = await tempResponse.json();
                
                // Petición de Calidad del Aire (AQI Europeo)
                const aqiResponse = await fetch(`https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${lat}&longitude=${lon}&current=european_aqi`);
                const aqiData = await aqiResponse.json();

                // 3. Actualizar el DOM: Clima
                if (tempData.current) {
                    const temp = Math.round(tempData.current.temperature_2m);
                    const codigoClima = tempData.current.weather_code;
                    document.getElementById('sensor-temp-val').innerText = temp;
                    
                    window.climaLocal.llueve = (codigoClima >= 51 && codigoClima <= 99);
                }
                
                // 4. Actualizar el DOM: Calidad del Aire
                if (aqiData.current) {
                    const aqi = Math.round(aqiData.current.european_aqi);
                    window.climaLocal.aqi = aqi;
                    
                    // Invocar al Helper
                    const estadoAQI = obtenerDatosAQI(aqi);
                    
                    // Capturar los nodos del DOM
                    const aqiTextoElement = document.getElementById('sensor-aqi-texto');
                    const aqiIconoElement = document.getElementById('sensor-aqi-icono');
                    
                    // Inyectar texto descriptivo
                    if (aqiTextoElement) {
                        aqiTextoElement.innerText = estadoAQI.texto;
                        aqiTextoElement.className = `text-sm font-black uppercase tracking-wide ${estadoAQI.color}`;
                    }
                    // Inyectar SVG dinámico
                    if (aqiIconoElement) {
                        aqiIconoElement.innerHTML = estadoAQI.icono;
                        aqiIconoElement.className = estadoAQI.color;
                    }
                }
                
                const badge = document.getElementById("alert-badge");
                if (badge && badge.innerText.includes(trans('badge.safe') || 'SEGURO')) {
                    actualizarVideoMascota("Minor", ""); 
                }
                console.log(`Telemetría obtenida correctamente para coords: ${lat}, ${lon}`);
            } catch (error) {
                console.error("Error al obtener datos meteorológicos:", error);
            }
        }

        // 1.6 CONTROLADOR MULTIMEDIA (Transiciones)
        function actualizarVideoMascota(severidad, titular) {
            const mascotVideo = document.getElementById("mascot-video");
            const mascotSource = document.getElementById("mascot-source");

            if (!mascotVideo || !mascotSource) return;

            let transicion = "";
            let bucle = "";

            if (severidad === "Extreme" || severidad === "Severe" || severidad === "Moderate") {
                titular = titular.toUpperCase();
                
                if (titular.includes("INCENDIO") || titular.includes("FIRE") || titular.includes("INCÊNDIO")) {
                    transicion = "/V_Fuego.mp4";
                    bucle = "/V_Simulacro_Fuego.mp4";
                } 
                else if (titular.includes("TERREMOTO") || titular.includes("EARTHQUAKE") || titular.includes("SEISMO") || titular.includes("SISMO")) {
                    transicion = "/V_Terremoto.mp4";
                    bucle = "/V_Simulacro_Terremoto.mp4";
                } 
                else if (titular.includes("AIRE") || titular.includes("AIR") || titular.includes("AR")) {
                    transicion = "/V_CalidadAire_Severo.mp4"; 
                    bucle = transicion; 
                    
                } 
            } else {
                // ESTADO SEGURO (Depende del clima local)
                transicion = window.climaLocal.llueve ? "/V_Lluvia.mp4" : "/V_Sol.mp4";
                bucle = transicion; // El estado normal siempre es un bucle continuo
            }

            // Evitamos reiniciar la animación si ya estamos reproduciendo el vídeo correcto
            const srcActual = mascotSource.getAttribute("src");
            if (srcActual.includes(transicion) || srcActual.includes(bucle)) {
                return; 
            }

            // Limpiamos eventos anteriores para que no se vuelvan locos
            mascotVideo.onended = null;

            // 1. Cargar y reproducir la transición
            mascotSource.setAttribute("src", transicion);
            
            // Si la transición y el bucle son distintos, quitamos el loop de HTML
            if (transicion !== bucle) {
                mascotVideo.loop = false; 
                
                // EVENTO: Cuando termine la transición, cambiamos al simulacro y lo ponemos en bucle
                mascotVideo.onended = () => {
                    mascotSource.setAttribute("src", bucle);
                    mascotVideo.loop = true;
                    mascotVideo.load();
                    mascotVideo.play().catch(e => console.warn(e));
                };
            } else {
                // Si es estado normal o aire (que no tienen 2 vídeos), activamos bucle desde el principio
                mascotVideo.loop = true; 
            }

            mascotVideo.load();
            mascotVideo.play().catch(e => console.warn("Autoplay bloqueado:", e));
        }

        // Ejecutar inmediatamente al cargar y luego cada 15 minutos (900000 ms)
        fetchLocalTelemetry();
        setInterval(fetchLocalTelemetry, 900000);

        // 2. CREDENCIALES
        const BROKER = credenciales.BROKER; 
        const PORT = Number(credenciales.PORT); 
        const USUARIO = credenciales.USUARIO;
        const PASSWORD = credenciales.PASSWORD;
        const TOPIC = credenciales.TOPIC;

        // 3. FUNCIONES DE ACTUALIZACIÓN VISUAL (DOM)
        function addToHistory(info) {
            const container = document.getElementById("history-container");
            const time = new Date().toLocaleTimeString('es-ES', {hour: '2-digit', minute:'2-digit'});
            
            // Eliminar el mensaje de "vacío" si existe
            const emptyMsg = container.querySelector('.italic');
            if(emptyMsg) emptyMsg.remove();

            let colorClass = "border-l-emerald-500 bg-emerald-50";
            if (info.severity === "Extreme" || info.severity === "Severe") colorClass = "border-l-red-500 bg-red-50";
            else if (info.severity === "Moderate") colorClass = "border-l-yellow-400 bg-amber-50";

            const item = document.createElement("div");
            item.className = `p-3 rounded-r-lg border-l-4 ${colorClass} text-sm flex justify-between items-center shadow-sm mb-2 slide-in`;
            item.innerHTML = `
                <div>
                    <p class="font-bold text-gray-800 uppercase leading-tight">${info.headline}</p>
                    <p class="text-[10px] text-gray-500 mt-1">${info.senderName || 'Sistema'}</p>
                </div>
                <span class="text-xs font-mono text-gray-400 whitespace-nowrap ml-2">${time}</span>
            `;
            container.prepend(item);

            if (container.children.length > 3) {
                container.lastElementChild.remove();
            }
        }

        function updateDashboard(info) {
            const body = document.getElementById("main-body");
            const card = document.getElementById("alert-card"); 
            const side = document.getElementById("alert-side-color");
            const iconBg = document.getElementById("alert-icon-bg");
            const badge = document.getElementById("alert-badge");
            
            // Actualizar Textos
            document.getElementById("headline").innerText = info.headline;
            if (document.getElementById("sender")) document.getElementById("sender").innerText = info.senderName || "Autoridad Competente";
            if (document.getElementById("description")) document.getElementById("description").innerText = info.description || trans('details.empty');

            // Limpieza profunda de colores anteriores
            body.classList.remove("bg-red-50", "bg-amber-50", "bg-[#e9e9e9]");
            card.classList.remove("pulse-red", "border-red-500", "border-yellow-400", "border-emerald-500");

            const sev = info.severity;
            
            // Lógica de peligro
            if (sev === "Extreme" || sev === "Severe") {
                body.classList.add("bg-red-50");
                card.classList.add("pulse-red", "border-red-500"); 
                side.className = "w-full h-4 landscape:w-4 landscape:h-auto bg-red-600 transition-colors duration-500";
                iconBg.className = "w-28 h-28 rounded-full bg-red-100 text-red-600 flex items-center justify-center shadow-inner transition-colors duration-500";
                iconBg.innerHTML = info.headline.includes("FUEGO") || info.headline.includes("FIRE") || info.headline.includes("SUTEA") ? iconFire : iconAlert; 
                badge.className = "px-3 py-1 rounded-full bg-red-600 text-white text-xs font-bold uppercase tracking-wider animate-pulse";
                badge.innerText = trans('badge.danger') || 'PELIGRO';
            } 
            else if (sev === "Moderate") {
                body.classList.add("bg-amber-50");
                card.classList.add("border-yellow-400");
                side.className = "w-full h-4 landscape:w-4 landscape:h-auto bg-yellow-400 transition-colors duration-500";
                iconBg.className = "w-28 h-28 rounded-full bg-yellow-100 text-yellow-600 flex items-center justify-center shadow-inner transition-colors duration-500";
                iconBg.innerHTML = iconWarning; 
                badge.className = "px-3 py-1 rounded-full bg-yellow-400 text-yellow-900 text-xs font-bold uppercase tracking-wider";
                badge.innerText = trans('badge.alert') || 'ALERTA';
            } 
            else {
                body.classList.add("bg-[#e9e9e9]");
                card.classList.add("border-emerald-500");
                side.className = "w-full h-4 landscape:w-4 landscape:h-auto bg-emerald-500 transition-colors duration-500";
                iconBg.className = "w-28 h-28 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shadow-inner transition-colors duration-500";
                iconBg.innerHTML = iconShield; 
                badge.className = "px-3 py-1 rounded-full bg-emerald-500 text-white text-xs font-bold uppercase tracking-wider";
                badge.innerText = trans('badge.safe') || 'SEGURO';
            }
            actualizarVideoMascota(sev, info.headline || "");
        }

        // 4. FUNCIONES MQTT 
        const client = new Paho.MQTT.Client(BROKER, PORT, "TotemWeb_" + parseInt(Math.random() * 100, 10));

        function onConnect() {
            console.log("¡Conexión exitosa a HiveMQ!");
            const dot = document.getElementById("conn-dot");
            const text = document.getElementById("conn-text");
            
            if (dot) dot.className = "w-2 h-2 rounded-full bg-green-500 animate-pulse";
            if (text) text.innerText = "ONLINE";
            
            client.subscribe(TOPIC);
        }

        function onConnectionLost(responseObject) {
            console.warn("Desconectado de HiveMQ:", responseObject.errorMessage);
            const dot = document.getElementById("conn-dot");
            const text = document.getElementById("conn-text");
            
            if (dot) dot.className = "w-2 h-2 rounded-full bg-red-500";
            if (text) text.innerText = "OFFLINE";
            
            // Reintentar conexión automáticamente a los 5 segundos
            setTimeout(() => {
                console.log("Intentando reconectar...");
                connectMQTT();
            }, 5000);
        }

       function onMessageArrived(message) {
            try {
                const payload = JSON.parse(message.payloadString);
                
                //Buscamos el bloque que coincida con el idioma actual del panel (LANG)
                const info = payload.alert.info.find(i => i.language === LANG) || payload.alert.info[0];
                
                console.log("Alerta procesada en idioma:", info.language);
                
                // Actualización visual
                addToHistory(info);
                updateDashboard(info);
                
            } catch (e) {
                console.error("Error al procesar el JSON de la alerta:", e);
            }
        }

        function connectMQTT() {
            console.log("Intentando conectar a:", BROKER, "por el puerto:", PORT);
            client.connect({
                userName: USUARIO,
                password: PASSWORD,
                useSSL: true, 
                onSuccess: onConnect,
                onFailure: function (e) {
                    console.error("Fallo absoluto al conectar a HiveMQ:", e);
                    setTimeout(connectMQTT, 5000);
                }
            });
        }

        // 5. ASIGNAR CALLBACKS Y ARRANCAR
        client.onConnectionLost = onConnectionLost;
        client.onMessageArrived = onMessageArrived;

        // Lanzamos la primera conexión
        connectMQTT();
    </script>
</body>
</html>